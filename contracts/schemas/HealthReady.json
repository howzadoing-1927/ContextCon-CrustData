        "stale",
        "missing",
        "unknown"
      ],
      "title": "Worker",
      "type": "string"
    }
  },
  "required": [
    "status",
    "database",
    "worker",
    "last_seen_age_seconds"
  ],
  "title": "HealthReady",
  "type": "object"
