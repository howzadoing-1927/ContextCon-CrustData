{
  "$defs": {
    "ApprovedFact": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "const": true,
          "title": "Approved",
          "type": "boolean"
        },
        "authority": {
          "const": "operator_approved",
          "title": "Authority",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "evidence_ids",
        "authority",
        "approved"
      ],
      "title": "ApprovedFact",
      "type": "object"
    },
    "FAQ": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "question": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer",
        "fact_ids"
      ],
      "title": "FAQ",
      "type": "object"
    }
  },
  "$id": "urn:outcome:outcome.v1:ProfileUpdate",
  "additionalProperties": false,
  "properties": {
    "approval_key": {
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "title": "Approval Key",
      "type": "string"
    },
    "approved_facts": {
      "items": {
        "$ref": "#/$defs/ApprovedFact"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Approved Facts",
      "type": "array"
    },
    "expected_profile_version": {
      "minimum": 0,
      "title": "Expected Profile Version",
      "type": "integer"
    },
    "faq": {
      "items": {
        "$ref": "#/$defs/FAQ"
      },
      "maxItems": 50,
      "title": "Faq",
      "type": "array"
    },
    "forbidden_promises": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Forbidden Promises",
      "type": "array"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "website_url": {
      "maxLength": 2048,
      "pattern": "^https://",
      "title": "Website Url",
      "type": "string"
    }
  },
  "required": [
    "expected_profile_version",
    "approval_key",
    "name",
    "website_url",
    "timezone",
    "approved_facts",
    "faq",
    "forbidden_promises"
  ],
  "title": "ProfileUpdate",
  "type": "object"
}
