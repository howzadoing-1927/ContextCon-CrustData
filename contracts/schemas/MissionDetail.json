          "type": "string"
        }
      },
      "required": [
        "name",
        "result",
        "evidence_ids",
        "reason"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "DecisionModelMeta": {
      "additionalProperties": false,
