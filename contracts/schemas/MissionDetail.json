    "ConversationView": {
      "additionalProperties": false,
      "properties": {
        "booking": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookingReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "buyer_role_label": {
          "const": "simulated buyer",
          "title": "Buyer Role Label",
          "type": "string"
        },
        "buyer_test_email": {
          "title": "Buyer Test Email",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/MessageView"
          },
          "title": "Messages",
          "type": "array"
        },
        "offered_slots": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Offered Slots",
          "type": "array"
        },
        "provider_thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Thread Id"
        },
        "state": {
          "$ref": "#/$defs/ConversationState"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "state",
        "version",
        "buyer_role_label",
        "buyer_test_email",
        "provider_thread_id",
        "messages",
        "offered_slots",
        "booking"
      ],
      "title": "ConversationView",
      "type": "object"
    },
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
