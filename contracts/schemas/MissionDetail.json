        "id",
        "kind",
        "status",
        "reason",
        "evidence_ids",
        "input_refs",
        "model",
        "policy",
        "proposed_action",
        "actual_action",
        "resolution",
        "created_at"
      ],
      "title": "DecisionView",
      "type": "object"
