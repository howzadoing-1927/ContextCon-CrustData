      "enum": [
        "accepted",
        "rejected",
        "blocked",
        "resolved"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "DecisionView": {
      "additionalProperties": false,
      "properties": {
        "actual_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActualAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "execution_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionLabel"
            },
            {
              "type": "null"
            }
