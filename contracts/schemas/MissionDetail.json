{
  "$defs": {
    "ActionState": {
      "enum": [
        "prepared",
        "executing",
        "succeeded",
        "failed",
        "unknown",
        "cancelled"
      ],
      "title": "ActionState",
      "type": "string"
    },
    "ActualAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "provider_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Ref"
        },
        "state": {
          "$ref": "#/$defs/ActionState"
        }
      },
      "required": [
        "action_id",
        "state",
        "provider_ref"
      ],
      "title": "ActualAction",
      "type": "object"
    },
    "BookingReceipt": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "attendee_acceptance": {
          "const": "not_verified",
          "title": "Attendee Acceptance",
          "type": "string"
        },
        "calendar_id": {
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "execution_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "html_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Html Link"
        },
        "mode": {
          "const": "simulation",
          "title": "Mode",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "event_id",
        "calendar_id",
        "start",
        "end",
        "timezone",
        "html_link",
        "verified_at",
        "attendee_acceptance",
        "mode"
      ],
      "title": "BookingReceipt",
      "type": "object"
    },
    "BuyerStatedNeed": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "message_id"
      ],
      "title": "BuyerStatedNeed",
      "type": "object"
    },
    "CampaignState": {
      "enum": [
        "draft",
        "running",
        "waiting_reply",
        "completed",
        "no_match",
        "needs_human",
        "paused",
        "stopped",
        "failed"
      ],
      "title": "CampaignState",
      "type": "string"
    },
    "ConversationState": {
      "enum": [
        "researching",
        "qualified",
        "drafting",
        "waiting_reply",
        "evaluating_reply",
        "offering_slots",
        "waiting_slot_acceptance",
        "booking",
        "booked",
        "completed",
        "declined",
        "suppressed",
        "needs_human",
        "send_unknown",
        "stopped"
