{
  "$defs": {
    "ApprovedProfileView": {
      "additionalProperties": false,
      "properties": {
        "approved_facts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Approved Facts",
          "type": "array"
        },
        "faq": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Faq",
          "type": "array"
        },
        "forbidden_promises": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Promises",
          "type": "array"
        }
      },
      "required": [
        "approved_facts",
        "faq",
        "forbidden_promises"
      ],
      "title": "ApprovedProfileView",
      "type": "object"
    },
    "ConnectionSummaryView": {
      "additionalProperties": false,
      "properties": {
        "account_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Account Email"
        },
        "calendar_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calendar Id"
        },
        "connection_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Id"
        },
        "granted_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Granted Scopes",
          "type": "array"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "seller",
                "buyer_test"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "status": {
          "enum": [
            "pending",
            "connected",
            "reauth_required",
            "revoked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "account_email",
        "granted_scopes",
        "calendar_id"
      ],
      "title": "ConnectionSummaryView",
      "type": "object"
    },
    "EvidenceSourceKind": {
      "enum": [
        "crustdata",
        "seller_website",
        "operator",
        "google_message",
        "google_calendar",
        "policy"
      ],
      "title": "EvidenceSourceKind",
      "type": "string"
    },
    "EvidenceView": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "execution_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fact_status": {
          "$ref": "#/$defs/FactStatus"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "provider_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Ref"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source As Of"
        },
        "source_kind": {
          "$ref": "#/$defs/EvidenceSourceKind"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        }
      },
      "required": [
        "id",
        "source_kind",
        "source_url",
        "provider_ref",
        "field_path",
        "excerpt",
        "retrieved_at",
        "source_as_of",
        "content_sha256",
        "fact_status"
      ],
      "title": "EvidenceView",
      "type": "object"
    },
    "ExecutionLabel": {
      "description": "Provenance shown in UI, logs and video. Only LIVE counts toward P0 acceptance.",
      "enum": [
        "LIVE",
        "CACHED",
        "FIXTURE",
        "SIMULATED_BUYER"
      ],
      "title": "ExecutionLabel",
      "type": "string"
    },
    "FactStatus": {
      "enum": [
        "observed",
        "operator_approved",
        "hypothesis",
        "conflicted"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "HealthReady": {
      "additionalProperties": false,
      "description": "Sanitized readiness summary. Returned as data on 200, and as error.details on 503.",
      "properties": {
        "database": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Database",
          "type": "string"
        },
        "last_seen_age_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Seen Age Seconds"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "worker": {
          "enum": [
            "fresh",
            "stale",
            "missing",
            "unknown"
          ],
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "status",
        "database",
        "worker",
        "last_seen_age_seconds"
      ],
      "title": "HealthReady",
      "type": "object"
    },
    "IdealCustomer": {
      "additionalProperties": false,
      "properties": {
        "buyer_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Buyer Roles",
          "type": "array"
        },
        "criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "customer_type": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Customer Type",
          "type": "string"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Exclusions",
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Regions",
          "type": "array"
        },
        "timeline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeline"
        }
      },
      "required": [
        "customer_type",
        "regions",
        "buyer_roles",
        "criteria",
        "exclusions"
      ],
      "title": "IdealCustomer",
      "type": "object"
    },
    "SafePolicyView": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "consented_recipients": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Consented Recipients",
          "type": "array"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Minutes"
        },
        "limits": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limits"
        },
        "selected_calendar_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Calendar Id"
        },
        "simulation": {
          "title": "Simulation",
          "type": "boolean"
        },
        "working_hours": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Working Hours"
        }
      },
      "required": [
        "simulation",
        "consented_recipients",
        "selected_calendar_id",
        "working_hours",
        "duration_minutes",
        "limits"
      ],
      "title": "SafePolicyView",
      "type": "object"
    },
    "SellerBrief": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "founder_email": {
          "title": "Founder Email",
          "type": "string"
        },
        "founder_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Founder Name",
          "type": "string"
        },
        "pricing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing"
        },
        "service": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "founder_name",
        "founder_email",
        "service"
      ],
      "title": "SellerBrief",
      "type": "object"
    },
    "SourceView": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "website",
            "pasted_text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieved At"
        },
        "status": {
          "enum": [
            "ingesting",
            "ready",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "status",
        "retrieved_at",
        "evidence_ids"
      ],
      "title": "SourceView",
      "type": "object"
    }
  },
  "$id": "urn:outcome:outcome.v1:OrganizationView",
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "approved_facts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Approved Facts",
      "type": "array"
    },
    "config_version": {
      "title": "Config Version",
      "type": "integer"
    },
    "connection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConnectionSummaryView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/ConnectionSummaryView"
      },
      "title": "Connections",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceView"
      },
      "title": "Evidence",
      "type": "array"
    },
    "faq": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Faq",
      "type": "array"
    },
    "forbidden_promises": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Promises",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "ideal_customer": {
      "anyOf": [
        {
          "$ref": "#/$defs/IdealCustomer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/SafePolicyView"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovedProfileView"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "integer"
    },
    "proposed_facts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Proposed Facts",
      "type": "array"
    },
    "role": {
      "enum": [
        "owner",
        "member"
      ],
      "title": "Role",
      "type": "string"
    },
    "seller_brief": {
      "anyOf": [
        {
          "$ref": "#/$defs/SellerBrief"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceView"
      },
      "title": "Sources",
      "type": "array"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "viewer_role": {
      "anyOf": [
        {
          "enum": [
            "owner",
            "member"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Viewer Role"
    },
    "website_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Website Url"
    },
    "worker": {
      "$ref": "#/$defs/HealthReady"
    }
  },
  "required": [
    "id",
    "name",
    "website_url",
    "timezone",
    "role",
    "profile_version",
    "approved_at",
    "profile",
    "config_version",
    "policy",
    "connections",
    "worker"
  ],
  "title": "OrganizationView",
  "type": "object"
}
