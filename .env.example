# Outcome AI server-side configuration names (doc 10). Values are private; never commit real values.
# Browser-only names (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_API_BASE_URL) belong to apps/web (D2).

# Supabase / database (API + worker only)
SUPABASE_URL=
# Anon/publishable key: server uses it only in tests for direct-client RLS checks.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection or SESSION pooler (port 5432); not the 6543 transaction pooler.
DATABASE_URL=
# Application schema (tables live here; sessions use search_path=<schema>) and private evidence bucket.
OUTCOME_DB_SCHEMA=outcome
STORAGE_BUCKET=outcome-evidence
# Optional: legacy HS256 secret. Asymmetric keys are verified via JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
# Optional JWKS override.
SUPABASE_JWKS_URL=

# Google OAuth (API; worker refresh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=

# Azure OpenAI (worker). Deployment names and API version must be account-verified.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DECISION_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Crustdata (worker)
CRUSTDATA_API_KEY=
CRUSTDATA_BASE_URL=https://api.crustdata.com

# Origins
API_PUBLIC_ORIGIN=
WEB_PUBLIC_ORIGIN=
ALLOWED_CORS_ORIGINS=

# Demo session (off by default). POST /api/v1/demo/session mints a short-lived token for DEMO_ORGANIZATION_ID.
DEMO_SESSION_ENABLED=false
DEMO_ORGANIZATION_ID=
DEMO_SESSION_TTL_SECONDS=3600

# Safety switches
SIMULATION_ONLY=true
LIVE_EFFECTS_ENABLED=false

# Worker
WORKER_ID=
# Organization whose runtime_json holds the single-worker heartbeat (readiness reads it).
RUNTIME_ORGANIZATION_ID=
RELEASE_SHA=
TASK_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=60
ACTION_EXECUTING_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=20
