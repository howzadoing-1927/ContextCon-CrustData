# fixture: serve labeled FIXTURE data in the browser, no backend needed.
# live: call the Outcome API at NEXT_PUBLIC_API_BASE_URL with a Supabase session.
NEXT_PUBLIC_OUTCOME_API_MODE=fixture
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Required in live mode only. Public anon key; never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Enables real website reading on the landing page.
FIRECRAWL_API_KEY=
